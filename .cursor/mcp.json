{
  "mcpServers": {
    "mysql-manager": {
      "command": "npx",
      "args": [
        "-y",
        "@liangshanli/mcp-server-mysql"
      ],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "",
        "MYSQL_DATABASE": "pmpchris",
        "ALLOW_DDL": "true",
        "ALLOW_DELETE": "true"
      },
      "description": "Laragon MySQL access for pmpchris database."
    }
  }
}
